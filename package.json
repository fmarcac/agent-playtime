{
  "name": "agent-playtime",
  "version": "0.4.0",
  "description": "Steam-style playtime tracking for CLI agent harnesses: Claude Code, Codex, OpenCode, Pi, Copilot CLI, Gemini CLI, Cline, Qwen Code, Goose and Factory Droid",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "pi",
    "copilot",
    "gemini-cli",
    "cline",
    "qwen-code",
    "goose",
    "factory-droid",
    "ccstatusline",
    "playtime",
    "statusline",
    "cli"
  ],
  "license": "MIT",
  "author": "Filip Marcac",
  "homepage": "https://github.com/fmarcac/agent-playtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmarcac/agent-playtime.git"
  },
  "bugs": {
    "url": "https://github.com/fmarcac/agent-playtime/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "playtime": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./opencode": "./dist/adapters/opencode/plugin.js",
    "./pi": "./dist/adapters/pi/extension.js",
    "./lib": "./dist/lib.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "adapters",
    "hooks",
    ".claude-plugin",
    ".codex-plugin",
    ".agents",
    ".opencode",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/postbuild.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "prepare": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
